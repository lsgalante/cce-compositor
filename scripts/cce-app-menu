#!/usr/bin/env bash
# cce-app-menu — Context menu for CCE application windows
#
# Opened by the compositor (cursor.rs, the right-click border path): from a
# right-click on a window's handle disc in adjust mode, and from a right-click
# anywhere on a window in overview. It is a `cce-cloud --json` popup, the same
# mechanism as cce-desktop-menu and cce-grid's desktop-item menu, so it looks
# and dismisses like every other menu in the DE. The first page holds the
# window verbs; "Window Mode" is a second page (a button with `target_page`
# switches pages without closing the popup) listing the modes `ccectl
# set-mode` accepts, the current one marked.
#
# The mode is set with `set-mode <mode> <id>` — one window, by id — NOT
# `mode <mode> <app_id>`, which appends a persistent rule that also
# re-classes every later window of that app.

CCE_CTL="$HOME/.local/bin/ccectl"
CLEAR_CLOUD="$HOME/.local/bin/cce-cloud"

# Default to empty/none
x_arg=""
y_arg=""
window_index=""
app_id=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -x|--x-pos)
            # A flag with no value must still consume itself: bare `shift 2`
            # is a no-op when one arg remains, and the loop spins forever.
            if [[ $# -ge 2 ]]; then x_arg="-x $2"; shift 2; else shift; fi
            ;;
        -y|--y-pos)
            if [[ $# -ge 2 ]]; then y_arg="-y $2"; shift 2; else shift; fi
            ;;
        -i|--window-id)
            if [[ $# -ge 2 ]]; then window_index="$2"; shift 2; else shift; fi
            ;;
        -a|--app-id)
            if [[ $# -ge 2 ]]; then app_id="$2"; shift 2; else shift; fi
            ;;
        *)
            shift
            ;;
    esac
done

if [[ -z "$window_index" || -z "$app_id" ]]; then
    echo "Usage: cce-app-menu -i <window_index> -a <app_id> [-x <x>] [-y <y>]" >&2
    exit 1
fi

# The window's current mode, so the submenu can mark it. `windows --json` is
# one object per line; a window that has gone since the click yields "".
# jq, not python, here and below: the popup waits on everything before it,
# and each python start costs 100-200 ms (more under load) where jq costs a
# few. cce-desktop-menu builds its menu the same way.
current_mode=$("$CCE_CTL" windows --json 2>/dev/null | jq -Rrn --arg want "$window_index" '
    first(inputs | fromjson? | select((.id | tostring) == $want)
          | .mode // "" | tostring | ascii_downcase)' 2>/dev/null)

# Build the layout in jq so the app_id (client-chosen text) is escaped
# for JSON rather than spliced into it.
json_layout=$(jq -nc --arg app_id "$app_id" --arg current "$current_mode" '
def btn($text; $id): {type: "button", text: $text, id: $id};
# The mode page is a radio group: cce-cloud draws the toolkit leading
# marks ("● " on, "○ " off) as the circle glyphs, and a `target_page` button
# as a page row (chevron-right) or, turning back to an earlier page, a back
# row (chevron-left) -- so no label spells a mark or an arrow of its own.
def mode($text; $id): btn((if $id == $current then "● " else "○ " end) + $text; $id);
{pages: [
    {title: $app_id, justify: "left", widgets: [
        btn("Window Mode"; "mode_page") + {target_page: 1},
        btn("Minimize"; "minimize"),
        btn("Close Window"; "close")
    ]},
    {title: "Window Mode", justify: "left", widgets: [
        mode("Floating"; "floating"),
        mode("Tiled"; "tiled"),
        mode("Fullscreen"; "fullscreen"),
        btn("Back"; "back") + {target_page: 0}
    ]}
]}')

# Spawn cce-cloud with the json layout and coordinates
selected=$(echo "$json_layout" | $CLEAR_CLOUD --json $x_arg $y_arg 2>/dev/null)

[[ -z "$selected" ]] && exit 0

btn=$(jq -r '.button // ""' <<<"$selected" 2>/dev/null)

[[ -z "$btn" ]] && exit 0

case "$btn" in
    "floating"|"tiled"|"fullscreen")
        $CCE_CTL set-mode "$btn" "$window_index"
        ;;
    "minimize")
        # minimize/close act on the focused window: focus this one first.
        $CCE_CTL focus-window "$window_index"
        $CCE_CTL minimize
        ;;
    "close")
        $CCE_CTL focus-window "$window_index"
        $CCE_CTL close
        ;;
esac
